<?xml version="1.0" encoding="utf-8"?>
<!-- dev flavor only (A11, ADR-014). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Analytics without advertising id. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <application>
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- Crashlytics validation: adb shell am broadcast -a com.nutri.android.dev.TEST_CRASH
             -n com.nutri.android.dev/com.nutri.android.core.telemetry.TestCrashReceiver.
             DUMP is held by the adb shell, not by regular apps. Not a screen. -->
        <receiver
            android:name="com.nutri.android.core.telemetry.TestCrashReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.nutri.android.dev.TEST_CRASH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
