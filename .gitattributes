# Shell scripts run in bash (Linux, Git Bash): always LF, even on Windows checkouts.
*.sh    text eol=lf
# Windows batch files need CRLF.
*.bat   text eol=crlf
# Binary assets: never touch line endings.
*.png   binary
*.jpg   binary
*.ttf   binary
*.jar   binary
# Repository skill Markdown must remain byte-identical across all four mirrors.
/.agents/skills/**/*.md text eol=lf
/.grok/skills/**/*.md text eol=lf
/.hermes/skills/**/*.md text eol=lf
/.claude/skills/**/*.md text eol=lf
