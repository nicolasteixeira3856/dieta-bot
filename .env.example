# Copie: cp .env.example .env
# NUNCA commite .env. NUNCA cole no chat.

APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8080
INVITE_CODE=troca-isto

# LLM — só Luna
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_EFFORT=none
OPENAI_API_KEY=

# Safety identifier (CP3, ADR-025). Segredo próprio, nunca o convite nem a key; não trocar a cada deploy.
# Vazio = sem safety_identifier (/health safety_id off). SERVER_ENV vazio = dev.
SAFETY_ID_SECRET=
SERVER_ENV=dev

# Flutter / clientes
API_PUBLIC_URL=http://127.0.0.1:8080

# Named tunnel (vazio no começo)
TUNNEL_TOKEN=

# Reservado. Vazio no S0.
XAI_API_KEY=
